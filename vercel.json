{
  "regions": ["gru1"],
  "functions": {
    "api/processo.js": { "maxDuration": 60 },
    "api/pauta.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] }
  ]
}
